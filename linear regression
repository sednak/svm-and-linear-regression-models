import numpy as np
import matplotlib.pyplot as plt
from sklearn.datasets import fetch_california_housing
from sklearn.linear_model import LinearRegression
from sklearn.model_selection import train_test_split
housing=fetch_california_housing()
x=housing.data
y=housing.target
print(housing.feature_names)
x_med_inc = x[:,[0]]
print("First 10 values of 'MedInc':")
print(x_med_inc[:10])
print("\nShape of x_med_inc:")
print(x_med_inc.shape)
x_train, x_test, y_train, y_test = train_test_split(x_med_inc, y, test_size=0.2, random_state=42)
print(f"Number of training samples: {x_train.shape[0]}")
print(f"Number of testing samples: {x_test.shape[0]}")
model=LinearRegression()
model.fit(x_train,y_train)
y_pred = model.predict(x_test)
plt.figure(figsize=(8, 6))
plt.scatter(x_test, y_test, color='blue', label='Actual Prices', alpha=0.5)
plt.plot(x_test, y_pred, color='red', linewidth=2, label='Predicted Prices')
plt.xlabel('Median Income')
plt.ylabel('House Prices')
plt.title('Linear Regression: House Price vs Median Income')
plt.legend()
plt.grid(True)
plt.show()
